# ──────────────────────────────────────────────
# Agente de Riesgo — Variables de entorno
# Copia este archivo a .env.local y completa los valores
# ──────────────────────────────────────────────

# OpenRouter — LLM routing (requerido)
# Obtén tu clave en: https://openrouter.ai/settings/keys
# Los modelos gratuitos funcionan sin créditos. Los demo cases no requieren esta clave.
OPENROUTER_API_KEY=

# Exa.ai — búsqueda semántica web (opcional)
# Sin esta clave el agente opera sin evidencia web (solo datos de Truora)
# Obtén tu clave en: https://exa.ai
EXA_API_KEY=

# Truora — verificación de identidad y antecedentes (opcional)
# Sin esta clave se activa el modo mock (ver TRUORA_MOCK abajo)
# Obtén tu clave en: https://truora.com
TRUORA_API_KEY=

# Modo mock de Truora — activa datos simulados cuando no hay API key
# true  → usa datos de prueba (siempre retorna perfil limpio)
# false → usa la API real de Truora (requiere TRUORA_API_KEY)
TRUORA_MOCK=true

# API key interna — protege el endpoint /api/evaluate en producción (opcional)
# Sin esta clave el endpoint es público. Genera una con: openssl rand -hex 32
INTERNAL_API_KEY=
